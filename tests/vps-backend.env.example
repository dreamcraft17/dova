# =============================================================================
# DOVA VPS — Backend env (Paystack TEST mode)
# Copy to VPS:  /var/www/dova/apps/backend/.env
# migrate/seed scripts also read this file (see scripts/load-env.js)
# =============================================================================
# Replace every CHANGE_ME / sk_test_REPLACE / pk placeholders before use.
# Never commit the real .env file to git.

NODE_ENV=production
PORT=3000

# --- App ---
USE_IN_MEMORY=false
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ADMIN_PASSWORD=admin1234
SUPPLIER_PASSWORD=supplier1234

# --- Database (local Postgres on same VPS) ---
DATABASE_URL=postgresql://dova:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/dova
# Optional — omit unless redis-server is running on the VPS
# REDIS_URL=redis://127.0.0.1:6379

# --- URLs (adjust if your API host is different) ---
# Frontend (customer site)
FRONTEND_URL=https://dova.dntech.id
# Required when frontend and API are on different domains
CROSS_SITE_COOKIES=true

# --- Paystack TEST mode only (Dashboard → Test Mode ON) ---
PAYSTACK_SECRET_KEY=sk_test_REPLACE
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=https://dova.dntech.id/checkout/verify
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer

# --- Paystack Dashboard → Webhooks (Test Mode) ---
# URL: POST https://api.dova.dntech.id/api/v1/payments/webhook
# Event: charge.success
# (Change api.dova.dntech.id if your API uses another hostname)

# --- Optional email ---
# RESEND_API_KEY=re_REPLACE
# EMAIL_FROM=DOVA <noreply@dova.dntech.id>
# SUPPORT_EMAIL=support@dova.dntech.id
