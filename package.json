{
  "name": "dova-mvp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "predev": "npm run build -w shared",
    "prepare": "npm run build -w shared",
    "dev": "concurrently -n BE,FE -c cyan,yellow \"npm run dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "dev:web": "npm run dev",
    "build": "npm run build -w shared && npm run build -w apps/backend && npm run build -w apps/frontend",
    "test": "npm run test:unit && npm run test:backend",
    "test:unit": "npm run build -w shared && jest --config jest.config.js --runInBand",
    "test:coverage": "jest --config jest.config.js --runInBand --coverage",
    "test:backend": "npm run test:compile -w apps/backend",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:all": "npm run db:migrate",
    "db:seed": "node scripts/seed.js",
    "db:reset-logins": "node scripts/reset-demo-logins.js",
    "db:seed:week3": "node scripts/seed-week3.js",
    "smoke:week4": "node scripts/smoke-week4.js",
    "smoke:staging": "node scripts/smoke-production-api.js",
    "smoke:production": "node scripts/smoke-production-api.js",
    "typecheck": "npm run build -w shared && npm run typecheck -w apps/backend && npm run typecheck -w apps/frontend",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/throttler": "^6.4.0"
  }
}
