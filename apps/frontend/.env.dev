# DOVA frontend — local development
# Usage: cp .env.dev .env.local

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# FeedLog integrated at /feedback (same origin, proxied to :3010)
NEXT_PUBLIC_FEEDLOG_INTEGRATED=true
FEEDLOG_INTERNAL_URL=http://localhost:3010

# External FeedLog (legacy): set INTEGRATED=false and uncomment:
# NEXT_PUBLIC_FEEDLOG_INTEGRATED=false
# NEXT_PUBLIC_FEEDLOG_URL=http://localhost:3010
