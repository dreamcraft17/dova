# DOVA backend — local development
# Usage: cp .env.dev .env

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

JWT_SECRET=dova-dev-jwt-secret-change-if-you-want

USE_IN_MEMORY=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379

ADMIN_PASSWORD=admin1234
SUPPLIER_PASSWORD=supplier1234

PAYSTACK_SECRET_KEY=
# Test mode: sk_test_... from Paystack Dashboard (Settings → API Keys, Test Mode ON)
# Empty = mock payment (no Paystack UI). See dova-comp-wiki operations/PAYSTACK-TEST-MODE.md
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=http://localhost:3001/checkout/verify

# RESEND_API_KEY=
# EMAIL_FROM=DOVA Dev <dev@localhost>
# SUPPORT_EMAIL=support@dova.com
