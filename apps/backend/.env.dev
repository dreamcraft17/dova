# DOVA backend — local development
# Usage: cp .env.dev .env

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3002

JWT_SECRET=dova-dev-jwt-secret-change-if-you-want

USE_IN_MEMORY=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379

ADMIN_PASSWORD=admin1234
SUPPLIER_PASSWORD=supplier1234

PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# RESEND_API_KEY=
# EMAIL_FROM=DOVA Dev <dev@localhost>
# SUPPORT_EMAIL=support@dova.com

# FeedLog integrated — public URL is DOVA frontend + /feedback
FEEDLOG_BASE_URL=http://localhost:3002/feedback
# FEEDLOG_SSO_SECRET=copy-from-feedlog-dashboard-developer-sso
