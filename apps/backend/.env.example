NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3002
JWT_SECRET=change-me-in-development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
# Optional — defaults to {FRONTEND_URL}/checkout/verify (Paystack callback_url)
# PAYSTACK_CALLBACK_URL=https://dova.dntech.id/checkout/verify
# PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer
ADMIN_PASSWORD=admin1234
SUPPLIER_PASSWORD=supplier1234
USE_IN_MEMORY=true
# Public API base used in stored upload URLs (production: https://api.dova.dntech.id)
API_PUBLIC_URL=http://localhost:3000
# Local disk upload root (default: apps/backend/uploads when cwd is apps/backend)
# UPLOAD_DIR=/var/lib/dova/uploads
# Set to true when frontend and API run on different origins (e.g. Vercel + separate API host)
CROSS_SITE_COOKIES=false
