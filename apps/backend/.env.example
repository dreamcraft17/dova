NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3002
JWT_SECRET=change-me-in-development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
# Optional — defaults to {FRONTEND_URL}/checkout/verify (Paystack callback_url)
# PAYSTACK_CALLBACK_URL=https://dova.dntech.id/checkout/verify
# PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer
ADMIN_PASSWORD=change-me-admin-password
USE_IN_MEMORY=true
# Set to true when frontend and API run on different origins (e.g. Vercel + separate API host)
CROSS_SITE_COOKIES=false
