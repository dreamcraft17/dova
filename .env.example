NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
JWT_SECRET=change-me-in-development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
ADMIN_PASSWORD=change-me-admin-password
USE_IN_MEMORY=true

# AI chat (Botpress Chat API) — find the webhook id in the Botpress dashboard under
# your bot's Chat integration configuration (https://webhook.botpress.cloud/$WEBHOOK_ID).
BOTPRESS_WEBHOOK_ID=
BOTPRESS_CHAT_API_URL=https://chat.botpress.cloud
BOTPRESS_REPLY_TIMEOUT_MS=20000
