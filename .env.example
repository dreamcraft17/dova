NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
JWT_SECRET=change-me-in-development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
ADMIN_PASSWORD=change-me-admin-password
USE_IN_MEMORY=true

# Official HTTP clients. Format: name:secret,name:secret
# The browser must never see these — the storefront injects X-Api-Key via /api/gateway.
DOVA_INTEGRATION_KEYS=storefront:dev-storefront-key

# AI chat (Google Gemini API). Keep the key server-side; never expose it to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Keep interactive chat fast; set to 2 only when transient Gemini failures need a retry.
GEMINI_MAX_ATTEMPTS=1
# Optional: use another model if the primary model is temporarily overloaded (for example gemini-2.5-flash).
GEMINI_FALLBACK_MODEL=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Transactional email (backend only; use a verified sending domain)
EMAIL_PROVIDER=resend
EMAIL_FROM="DOVA <no-reply@your-domain.com>"
RESEND_API_KEY=
# Legacy SMTP is supported only when EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
