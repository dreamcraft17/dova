# DOVA — local development (in-memory, no Docker required)
# Usage: cp .env.dev .env  (root — for db:migrate / db:seed scripts)

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

JWT_SECRET=dova-dev-jwt-secret-change-if-you-want

USE_IN_MEMORY=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dova
REDIS_URL=redis://localhost:6379

ADMIN_PASSWORD=admin1234
SUPPLIER_PASSWORD=supplier1234

PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Local development does not send real email. OTP is logged by the backend.
EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="DOVA Dev <dev@your-domain.com>"
# SUPPORT_EMAIL=support@your-domain.com
